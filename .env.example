# Database
DATABASE_URL=postgresql+asyncpg://aatp:aatp@localhost:5432/aatp
DATABASE_URL_SYNC=postgresql://aatp:aatp@localhost:5432/aatp

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Application
AATP_ENV=development
AATP_LOG_LEVEL=INFO

# Scraper rate limiting
SCRAPER_REQUEST_DELAY_SECONDS=2.0
SCRAPER_MAX_CONCURRENT_REQUESTS=3

# Alert thresholds (configurable)
PRICE_MOVEMENT_ALERT_THRESHOLD_PCT=10.0
CONSENSUS_ACTIONABLE_THRESHOLD=4
CONSENSUS_WATCHLIST_THRESHOLD=2
MIN_NET_RETURN_THRESHOLD_PCT=25.0
MAX_HOLD_PERIOD_MONTHS=24

# Email alerts (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
